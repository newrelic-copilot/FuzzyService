<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" disableAnsi="false">
    <!--
        Hardened Log4j 2 configuration.
        - formatMsgNoLookups="true" prevents message-pattern lookups (extra defence in depth).
        - No JNDI-based appenders or lookups are configured.
        - JNDI is disabled by default from Log4j 2.17.0 onwards.
    -->
    <Properties>
        <Property name="log.pattern">%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %logger{36} - %msg%n</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${log.pattern}" disableAnsi="false"/>
        </Console>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
